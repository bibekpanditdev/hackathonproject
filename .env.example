# GROQ API Configuration (Primary Provider for Llama 3.3 70B)
# Vite only exposes vars prefixed with VITE_ to frontend code — keep the VITE_ versions.
# Get a free key at https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA API Configuration (Fallback Provider, used automatically if Groq fails/rate-limits)
# Get a free key at https://build.nvidia.com
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VITE_NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# GEMINI_API_KEY: Required only for the legacy server-side routes in server.ts.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
VITE_APP_URL=http://localhost:5173
